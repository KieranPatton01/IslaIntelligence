# Copy this file to .env.local (gitignored) and fill in your real values.
# Never commit .env.local to source control.

# ── Cloudflare Worker URL ──
VITE_WORKER_URL=https://isla-intelligence-proxy.YOUR_SUBDOMAIN.workers.dev

# ── Firebase Config ──
VITE_FIREBASE_API_KEY=PLACEHOLDER_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
