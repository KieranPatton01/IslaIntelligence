rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthorized() {
      return request.auth != null
        && request.auth.token.email in ['isingingbanana@gmail.com', 'iscowper@icloud.com', 'developer@ii.com'];
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthorized() && request.auth.uid == userId;

      // Write: enforce auth, owner, file size (max 10 MB) and allowed MIME types
      allow write: if isAuthorized()
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)')
                     || request.resource.contentType.matches('audio/(webm|mp4|mpeg|ogg|wav)')
                     || request.resource.contentType.matches('video/(mp4|webm)')
                   );

      allow delete: if isAuthorized() && request.auth.uid == userId;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
