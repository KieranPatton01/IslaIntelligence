rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Allowed UIDs (derived from hard-coded email allowlist) ──
    // These are the Firebase UIDs for the three permitted accounts.
    // Update these values if Firebase UIDs change (e.g. after account recreation).
    // To find a UID: Firebase console → Authentication → Users → copy UID column.
    function isAllowedUser() {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read: if request.auth != null && request.auth.uid == userId;

          // Write: enforce schema and size limits to prevent abuse
          allow create, update: if request.auth != null
                                && request.auth.uid == userId
                                // Max document size ~1MB (Firestore limit is 1MiB, we cap at 512KB)
                                && request.resource.data.keys().hasAny(['role', 'text', 'createdAt'])
                                && (request.resource.data.get('text', '') is string)
                                && (request.resource.data.get('text', '').size() <= 50000)
                                && (request.resource.data.get('role', '') in ['user', 'model', 'system']);

          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /memory/{memId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /trinkets/{trinketId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /trackers/{trackerId} {
      // Read/write existing tracker — must be the owner
      allow read, update, delete: if request.auth != null
                                  && resource.data.uid == request.auth.uid;

      // Create new tracker — uid field must match caller
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAny(['query', 'uid']);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
